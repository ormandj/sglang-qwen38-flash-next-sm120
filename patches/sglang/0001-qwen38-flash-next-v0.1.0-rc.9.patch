+        b,
+        a,
+        mixed_qkvz,
+        mixed_ba,
+        conv_state,
+        conv_weight,
+        conv_bias,
+        conv_state_indices,
+        mixed_qkvz.stride(0),
+        mixed_qkvz.stride(1),
+        mixed_ba.stride(0),
+        mixed_ba.stride(1),
+        conv_state.stride(0),
+        conv_state.stride(1),
+        conv_state.stride(2),
+        conv_weight.stride(0),
+        conv_weight.stride(1),
+        conv_state_indices.stride(0),
