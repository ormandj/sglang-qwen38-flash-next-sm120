+            sequence_lengths=sequence_lengths,
+            token_to_batch_idx=token_to_batch_idx,
+            token_slot_table=token_slot_table,
+            indexer_metadata=indexer_metadata,
+            row_req_pool_indices=row_req_pool_indices,
