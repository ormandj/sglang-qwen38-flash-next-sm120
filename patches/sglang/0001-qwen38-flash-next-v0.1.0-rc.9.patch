+    from sglang.kernels.ops.elementwise.fast_topk import fast_topk
+
+    torch.manual_seed(23)
+    device = torch.device("cuda")
+    batch, heads, head_dim = 3, 8, 128
+    page_size, max_model_len = 64, 1024
+    pages_per_row = max_model_len // page_size
+    context_lens = torch.tensor([333, 769, 1003], dtype=torch.int32, device=device)
+    cache = torch.randn(
+        batch * pages_per_row,
+        page_size,
+        1,
+        head_dim,
+        dtype=torch.bfloat16,
+        device=device,
+    )
+    page_table = torch.randperm(
+        batch * pages_per_row, dtype=torch.int32, device=device
+    ).reshape(batch, pages_per_row)
+    q = torch.randn(batch, heads, head_dim, dtype=torch.bfloat16, device=device)
+
+    initialized = qsa_mqa_module.qsa_mqa_decode(
+        q, cache, page_table, context_lens, max_model_len=max_model_len
+    )
+    uninitialized = qsa_mqa_module.qsa_mqa_decode(
+        q,
+        cache,
+        page_table,
+        context_lens,
+        max_model_len=max_model_len,
+        initialize_padding=False,
+    )
+    positions = torch.arange(max_model_len, device=device).unsqueeze(0)
+    unused = positions >= context_lens[:, None]
+    uninitialized.masked_fill_(unused, torch.finfo(torch.float32).max)
+
+    topk = 512
+    initialized_indices = fast_topk(
+        initialized, context_lens, topk, row_starts=None
+    )
+    uninitialized_indices = fast_topk(
+        uninitialized, context_lens, topk, row_starts=None
+    )
+    for row in range(batch):
+        valid_count = min(int(context_lens[row]), topk)
+        expected_indices = initialized_indices[row, :valid_count]
+        actual_indices = uninitialized_indices[row, :valid_count]
+        assert torch.all((actual_indices >= 0) & (actual_indices < context_lens[row]))
+        assert torch.equal(
+            torch.sort(actual_indices).values,
+            torch.sort(expected_indices).values,
+        )
+        expected_values = initialized[row].index_select(0, expected_indices.long())
+        actual_values = uninitialized[row].index_select(0, actual_indices.long())
+        assert torch.equal(
+            torch.sort(actual_values).values,
+            torch.sort(expected_values).values,
+        )
+        assert torch.all(uninitialized_indices[row, valid_count:] == -1)
+
+
+def test_qsa_sparse_attention_matches_explicit_gqa():
+    torch.manual_seed(2)
+    q = torch.randn(2, 4, 16, dtype=torch.bfloat16)
+    k = torch.randn(7, 2, 16, dtype=torch.bfloat16)
+    v = torch.randn(7, 2, 16, dtype=torch.bfloat16)
+    slots = torch.full((2, FINAL_TOPK), -1, dtype=torch.int32)
+    slots[0, :4] = torch.tensor([0, 2, 4, 6])
+    slots[1, :3] = torch.tensor([1, 3, 5])
+    actual = qsa_sparse_attention(q, k, v, slots)
+    expected_rows = []
+    for row, selected in enumerate((slots[0, :4], slots[1, :3])):
+        keys = k[selected.long()].repeat_interleave(2, dim=1)
+        values = v[selected.long()].repeat_interleave(2, dim=1)
+        scores = torch.einsum("hd,khd->hk", q[row].float(), keys.float()) / 4
+        expected_rows.append(
+            torch.einsum("hk,khd->hd", scores.softmax(-1), values.float()).to(
+                torch.bfloat16
+            )
+        )
+    torch.testing.assert_close(actual, torch.stack(expected_rows), rtol=2e-2, atol=2e-2)
+
