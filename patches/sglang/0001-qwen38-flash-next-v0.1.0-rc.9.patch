+    poisoned_shapes = []
+
+    class PoisonedEmptyTorch:
+        def __getattr__(self, name):
+            return getattr(torch, name)
+
+        @staticmethod
+        def empty(*args, **kwargs):
+            output = torch.empty(*args, **kwargs)
+            output.fill_(torch.finfo(output.dtype).max)
+            poisoned_shapes.append(tuple(output.shape))
+            return output
