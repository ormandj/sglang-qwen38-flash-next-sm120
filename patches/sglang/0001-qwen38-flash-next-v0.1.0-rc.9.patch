+    """Decode-only fused Qwen3.5 projection unpack and Conv1D state update."""
+    eligible, reason = can_use_fused_qkvzba_causal_conv1d_update_contiguous(
+        mixed_qkvz,
+        mixed_ba,
+        conv_state,
+        conv_weight,
+        conv_bias,
+        conv_state_indices,
