+    with (
+        patch.object(qwen4_exp_mtp, "get_parallel", return_value=parallel),
+        patch.object(qwen4_exp_mtp, "get_pp_group", return_value=None),
+        patch.object(qwen4_exp_mtp, "_mtp_quant_config", return_value=None),
+        patch.object(qwen4_exp_mtp, "Qwen4ExpModel", _FakeQwen4ExpModel),
+        patch.object(qwen4_exp_mtp, "ParallelLMHead", _FakeParallelLMHead),
+        patch.object(qwen4_exp_mtp, "LogitsProcessor", _FakeLogitsProcessor),
+    ):
+        model = qwen4_exp_mtp.Qwen4ExpForCausalLMMTP(config)
+
+    assert model.tp_size == 2
+    assert model.lm_head.use_attn_tp_group is True
