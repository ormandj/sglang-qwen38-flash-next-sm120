+    forward_batch = SimpleNamespace(
+        token_to_kv_pool=pool,
+        req_to_token_pool=runner.req_to_token_pool,
+        batch_size=bs,
+        req_pool_indices=torch.arange(bs, dtype=torch.int32),
+        seq_lens=torch.tensor(seq_lens, dtype=torch.int32),
